---
 .github/workflows/ci.yml | 19 ++++++++++++++++++-
 1 file changed, 18 insertions(+), 1 deletion(-)

diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index acd8ca8..633288f 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -18,7 +18,7 @@ jobs:
           swift --version
           python3 --version
 
-      # Swiftゲート: 数式・乱数消費順・週処理が委譲後もgolden(3年ビット一致)に合致するか
+      # Swiftゲート: 数式・乱数消費順・週処理が委譲後もgolden(3年・誤差1e-9以内の一致。乱数列はビット一致)に合致するか
       - name: swift test (GameCore)
         working-directory: GameCore
         run: swift test
@@ -26,3 +26,20 @@ jobs:
       # Pythonゲート: Python正典を変えてgolden再生成を忘れたドリフトを検出
       - name: golden sync (Python正典 ⇄ Swift golden)
         run: python3 tools/check_golden_sync.py
+
+  # iOS アプリのビルドゲート（懸念の台帳 L38）：アプリ層のコンパイル崩れを push ごとに検出する。
+  # pbxproj はコミット済み（project.yml が正本・xcodegen generate の結果を入れる運用）なので xcodegen は回さない。
+  app-build:
+    name: ManzaiGame build (iOS Simulator)
+    runs-on: macos-15
+    steps:
+      - uses: actions/checkout@v4
+
+      - name: Show toolchain
+        run: xcodebuild -version
+
+      - name: xcodebuild build
+        run: |
+          xcodebuild -project ManzaiGame/ManzaiGame.xcodeproj -scheme ManzaiGame \
+            -destination 'generic/platform=iOS Simulator' \
+            CODE_SIGNING_ALLOWED=NO -quiet build
